{
  "name": "power-platform-playwright-toolkit",
  "version": "0.0.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Toolkit for automating and testing Microsoft Power Platform applications with Playwright",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Microsoft",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/power-platform-playwright-samples.git",
    "directory": "packages/power-platform-playwright-toolkit"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rimraf dist"
  },
  "keywords": [
    "playwright",
    "power-platform",
    "power-apps",
    "dynamics-365",
    "testing",
    "automation"
  ],
  "peerDependencies": {
    "@playwright/test": "^1.57.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright-ms-auth": "0.0.19"
  }
}
