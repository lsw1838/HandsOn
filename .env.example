# $set-pp: PAC 환경·프로필 및 실제 Solution/Publisher 조회 후 기록
# $connect-pp: Solution의 Canvas 앱 조회 후 ID·Studio/실행 주소 자동 기록
# 아직 없는 앱 등의 값은 빈칸으로 둡니다. 실제 .env는 Git/배포에서 제외합니다.
# 비밀번호, 토큰, 쿠키는 기록하지 않습니다.

# Dataverse 연결과 활성 PAC 프로필
DATAVERSE_URL=
TENANT_ID=
MCP_CLIENT_ID=
PAC_AUTH_PROFILE=

# 실제 플러그인 manifest / 사용하는 에이전트
DATAVERSE_PLUGIN_VERSION=
DATAVERSE_PLUGIN_AGENT=codex

# PAC에서 확인한 개발 환경
POWER_APPS_ENVIRONMENT_NAME=
POWER_APPS_ENVIRONMENT_ID=

# 실제 Solution과 Publisher
SOLUTION_NAME=
SOLUTION_ID=
PUBLISHER_NAME=
PUBLISHER_ID=
PUBLISHER_PREFIX=

# 실제 Canvas 앱 메타데이터로 채움
CANVAS_APP_NAME=
CANVAS_APP_ID=
CANVAS_APP_TENANT_ID=
# 확인된 환경·앱 ID로 주소 구성
CANVAS_STUDIO_URL=
CANVAS_APP_URL=
